{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holy-ganges-dorms",
  "compatibility_date": "2024-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
